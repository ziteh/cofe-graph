# Control condition: pi only (no MCP server)
# Build context: repo root

FROM node:22-alpine
RUN apk add --no-cache python3 && npm install -g --ignore-scripts @earendil-works/pi-coding-agent

COPY benchmark/runner.py /bench/runner.py
COPY benchmark/cases /bench/cases

WORKDIR /fw
CMD ["python", "/bench/runner.py", "--condition", "ctrl", "--cases", "/bench/cases/questions.json", "--out", "/results"]
