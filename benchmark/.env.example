# Copy this file to .env and fill in your values.

# Required when using OpenRouter as backend:
OPENROUTER_API_KEY=sk-or-...

# Ollama needs no key; the default api_key used is "ollama".
# Override the default URL if your Ollama runs on a remote host:
# OLLAMA_BASE_URL=http://192.168.50.44:11434/v1
