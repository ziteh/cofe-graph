# Copy this file to .env and fill in your values.

# Ollama base URL — use the actual IP, not host.docker.internal, if the default doesn't resolve:
PI_BASE_URL=http://192.168.50.44:11434/v1

# Model to use for the agent (must be available on the Ollama server):
PI_MODEL=qwen2.5-coder:7b

# Provider name in pi's models.json (default: ollama — no need to change):
# PI_PROVIDER=ollama

# API key sent to Ollama (ignored by Ollama, but required by pi):
# PI_API_KEY=ollama

# Judge LLM — used by: uv run judge.py --judge ...
# Any OpenAI-compatible endpoint works here too.
JUDGE_BASE_URL=http://192.168.50.44:11434/v1
JUDGE_MODEL=qwen2.5-coder:7b
