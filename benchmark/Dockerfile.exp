# Experimental condition: pi + cofe-graph MCP server
# Build context: repo root

# Stage 1: build cofe-graph
FROM rust:alpine AS rust-builder
RUN apk add --no-cache musl-dev
WORKDIR /src
COPY Cargo.toml Cargo.lock ./
COPY src ./src
RUN cargo build --release

# Stage 2: runtime
FROM node:22-alpine
RUN apk add --no-cache python3 && npm install -g --ignore-scripts @earendil-works/pi-coding-agent

COPY --from=rust-builder /src/target/release/cofe-graph /usr/local/bin/cofe-graph
RUN chmod +x /usr/local/bin/cofe-graph

COPY benchmark/runner.py /bench/runner.py
COPY benchmark/cases /bench/cases

WORKDIR /fw
CMD ["python", "/bench/runner.py", "--condition", "exp", "--cases", "/bench/cases/questions.json", "--out", "/results"]
